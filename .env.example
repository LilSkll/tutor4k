# Spanish Tutor — Environment Variables
# Copy this file to .env.local and fill in your values.

# Optional: force-hide / force-show Google OAuth regardless of IP country.
# FORCE_HIDE_SOCIAL_OAUTH=1
# FORCE_SHOW_SOCIAL_OAUTH=1

# Production example: https://spanishwithpavel.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: comma-separated origins allowed for auth email redirects (both should work):
# NEXT_PUBLIC_AUTH_ORIGINS=https://spanishwithpavel.com,https://spanish-tutor-psi.vercel.app
# Optional: force all auth emails (reset/confirm) onto one reachable host:
# NEXT_PUBLIC_AUTH_EMAIL_ORIGIN=https://spanish-tutor-psi.vercel.app

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only: required for progress writes after lock-client-progress-writes.sql
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Upstash Redis (shared rate limits across Vercel isolates) ---
# Create a Redis DB at https://console.upstash.com → REST API keys
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
# Without these, the app falls back to in-process rate limits.

# --- Sentry (errors + light tracing) ---
# Create a Next.js project at https://sentry.io → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o000.ingest.sentry.io/000
# Optional server-only DSN override (defaults to NEXT_PUBLIC_SENTRY_DSN):
# SENTRY_DSN=
# Optional source-map upload on CI/Vercel builds:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# OAuth (Google) — secrets live in Supabase Dashboard, not here.
# 1) Authentication → URL Configuration:
#    Site URL = NEXT_PUBLIC_SITE_URL (canonical, e.g. https://spanishwithpavel.com)
#    Redirect URLs — add BOTH production hosts (required for email confirm + OAuth + password reset):
#      https://spanishwithpavel.com/auth/callback
#      https://spanishwithpavel.com/auth/recovery
#      https://spanish-tutor-psi.vercel.app/auth/callback
#      https://spanish-tutor-psi.vercel.app/auth/recovery
#    Email confirmation must land on /auth/callback (set via signUp emailRedirectTo),
#    not the bare Site URL — otherwise users hit the marketing home without a session.
#    If reset links always open .com while users are on vercel.app, vercel.app is
#    missing from Redirect URLs (Supabase falls back to Site URL).
# 2) Authentication → Providers → Google:
#    Google Cloud → OAuth Web client
#    Authorized redirect URI = https://YOUR-PROJECT.supabase.co/auth/v1/callback

# --- AI Providers ---
# Groq (primary, free/fast). Get a key at https://console.groq.com/keys
GROQ_API_KEY=YOUR-GROQ-KEY
GROQ_MODEL=llama-3.3-70b-versatile
# Optional extra Groq keys (only help if they are from different orgs):
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# DeepSeek (fallback when Groq rate-limits). https://platform.deepseek.com
DEEPSEEK_API_KEY=YOUR-DEEPSEEK-KEY
DEEPSEEK_MODEL=deepseek-v4-flash

# Google Gemini (optional last resort). https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR-GEMINI-KEY
GEMINI_MODEL=gemini-1.5-flash
